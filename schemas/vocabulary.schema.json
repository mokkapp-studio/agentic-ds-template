{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contracts/vocabulary.json",
  "description": "Vocabulario común de props, estados y eventos. Una misma idea se llama igual en todos los componentes. 'replaces' lista los sinónimos a los que sustituye este nombre: check falla si un contrato los usa. 'example' muestra el uso en código.",
  "type": "object",
  "required": ["props", "states", "events"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "props": { "$ref": "#/$defs/entries" },
    "states": { "$ref": "#/$defs/entries" },
    "events": { "$ref": "#/$defs/entries" }
  },
  "$defs": {
    "entries": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]*$": {
          "type": "object",
          "required": ["meaning"],
          "additionalProperties": false,
          "properties": {
            "meaning": { "type": "string" },
            "values": { "type": "array" },
            "replaces": { "type": "array", "items": { "type": "string" }, "description": "Sinónimos que este nombre sustituye. No se pueden usar en ningún contrato." },
            "example": { "type": "string", "description": "Cómo se ve en código." },
            "adr": { "type": ["string", "null"] }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
