{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato de componente",
  "description": "Fuente de verdad de un componente. Núcleo obligatorio + módulos opcionales (form, collection, member, overlay, range, media, data, content, composition, testing). null = se ha mirado y no hay dato o no está decidido (va con una entrada en meta.needsReview). Clave ausente = no se ha mirado.",
  "type": "object",
  "required": ["name", "version", "status", "category", "figma", "intent", "props", "states", "anatomy", "layout", "behavior", "a11y", "meta"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$", "description": "PascalCase. Igual que la carpeta." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "semver: patch = texto; minor = prop/estado/parte nueva; major = renombrar o quitar." },
    "status": { "type": "string", "enum": ["draft", "review", "stable", "deprecated"] },
    "category": { "type": "string", "enum": ["action", "form", "navigation", "feedback", "overlay", "data-display", "layout", "media", "typography", "other"] },

    "figma": {
      "description": "De dónde sale el componente en Figma y cómo se ha clasificado cada propiedad.",
      "type": "object",
      "required": ["url", "node", "componentKey", "variantCount", "properties"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": ["string", "null"] },
        "node": { "type": ["string", "null"], "description": "Id del component set o componente, p. ej. 12:345" },
        "componentKey": { "type": ["string", "null"] },
        "variantCount": { "type": ["integer", "null"], "minimum": 0 },
        "description": { "type": ["string", "null"], "description": "Descripción escrita en Figma, tal cual." },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "class"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "description": "Nombre exacto en Figma." },
              "type": { "type": "string", "enum": ["VARIANT", "BOOLEAN", "TEXT", "INSTANCE_SWAP", "SLOT"] },
              "values": { "type": "array" },
              "default": {},
              "class": {
                "type": "string",
                "enum": ["prop", "interaction", "declared", "content", "responsive", "mode", "figma-only"],
                "description": "Las 7 clases (ADR 0003). Solo 'prop' y 'declared' crean props; 'content' crea prop de texto o slot."
              },
              "mapsTo": { "type": ["string", "null"], "description": "Ruta en el contrato: props.size, states.disabled, anatomy.icon, layout.responsive…" },
              "figmaOnly": { "type": "boolean" }
            }
          }
        }
      }
    },

    "intent": {
      "description": "Para qué sirve. Borrador de IA (inferred) que una persona confirma. Obligatorio desde review.",
      "type": "object",
      "required": ["purpose", "useWhen", "dontUseFor", "related"],
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": ["string", "null"] },
        "useWhen": { "type": "array", "items": { "type": "string" } },
        "dontUseFor": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case"],
            "additionalProperties": false,
            "properties": {
              "case": { "type": "string" },
              "useInstead": { "type": ["string", "null"], "description": "Nombre de otro contrato o null." },
              "why": { "type": ["string", "null"] }
            }
          }
        },
        "related": { "type": "array", "items": { "type": "string" } }
      }
    },

    "props": {
      "description": "API pública. Solo de las clases 'prop', 'declared' y 'content' de Figma, o decididas en un ADR.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "default", "required", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "type": { "type": "string", "enum": ["enum", "boolean", "string", "number", "node", "icon", "array", "object"] },
          "values": { "type": "array", "description": "Obligatorio si type=enum." },
          "default": {},
          "required": { "type": "boolean" },
          "description": { "type": ["string", "null"] },
          "figma": {
            "type": ["object", "null"],
            "description": "null = la prop no existe en Figma (decidida en código o ADR).",
            "additionalProperties": false,
            "properties": {
              "property": { "type": "string" },
              "type": { "type": "string", "enum": ["VARIANT", "BOOLEAN", "TEXT", "INSTANCE_SWAP", "SLOT"] },
              "valueMap": { "type": "object", "description": "Valor en Figma → valor en código cuando no coinciden: {\"Large\": \"l\"}." }
            }
          }
        }
      }
    },

    "states": {
      "description": "interaction = lo resuelve el navegador (CSS); declared = lo pasa el consumidor (prop + aria); value = valor del componente (controlado o no).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "control"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "kind": { "type": "string", "enum": ["interaction", "declared", "value"] },
          "control": { "type": "string", "enum": ["browser", "consumer", "shared"], "description": "browser = CSS; consumer = prop; shared = controlado o no controlado (value + defaultValue)." },
          "values": { "type": "array" },
          "default": {},
          "prop": { "type": ["string", "null"], "description": "Prop que lo controla (declared/value)." },
          "css": { "type": ["string", "null"], "description": "Selector: :hover, :focus-visible, [data-disabled]…" },
          "aria": { "type": ["string", "null"], "description": "Atributo ARIA o nativo: aria-checked, disabled, aria-invalid…" },
          "figma": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": { "property": { "type": "string" }, "value": {} }
          }
        }
      }
    },

    "anatomy": {
      "description": "Partes del componente. Cada clave es una parte y en código lleva data-part=\"<clave>\". 'root' es obligatoria.",
      "type": "object",
      "required": ["root"],
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/part" }
    },

    "layout": {
      "description": "Lo que dice el auto layout de Figma.",
      "type": "object",
      "required": ["width", "height", "autoLayout", "responsive"],
      "additionalProperties": false,
      "properties": {
        "width": { "$ref": "#/$defs/sizing" },
        "height": { "$ref": "#/$defs/sizing" },
        "autoLayout": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "direction": { "type": "string", "enum": ["horizontal", "vertical", "wrap", "grid", "none"] },
            "align": { "type": ["string", "null"], "enum": ["start", "center", "end", "space-between", "baseline", "stretch", null] },
            "gap": { "$ref": "#/$defs/tokenRef" },
            "padding": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "block": { "$ref": "#/$defs/tokenRef" },
                "inline": { "$ref": "#/$defs/tokenRef" }
              }
            }
          }
        },
        "responsive": {
          "type": ["array", "null"],
          "description": "De la clase 'responsive' de Figma (Breakpoint=Mobile…). Nunca es una prop.",
          "items": {
            "type": "object",
            "required": ["breakpoint", "changes"],
            "additionalProperties": false,
            "properties": {
              "breakpoint": { "type": "string", "description": "Token o nombre: breakpoint.m" },
              "changes": { "type": "string" }
            }
          }
        }
      }
    },

    "behavior": {
      "description": "Comportamiento descrito con un patrón WAI-ARIA APG (ADR 0004). La librería que lo implementa se elige en ds.config.json.",
      "type": "object",
      "required": ["pattern", "events"],
      "additionalProperties": false,
      "properties": {
        "pattern": { "$ref": "#/$defs/pattern" },
        "element": { "type": ["string", "null"], "description": "Elemento HTML raíz: button, a, input, div, dialog…" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "when"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-zA-Z]*$", "description": "Nombre agnóstico: press, change, openChange, valueChange, dismiss. El stack le pone el prefijo (onPress, @press…)." },
              "payload": { "type": ["string", "null"], "description": "Qué entrega: boolean, string, number, {value}…" },
              "when": { "type": "string" }
            }
          }
        }
      }
    },

    "a11y": {
      "description": "Obligatorio completo desde review.",
      "type": "object",
      "required": ["role", "name", "keyboard", "focusVisible", "minTarget", "contrast"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": ["string", "null"], "description": "Rol ARIA o 'native' si el elemento ya lo da." },
        "name": {
          "type": ["object", "null"],
          "description": "De dónde sale el nombre accesible.",
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "enum": ["content", "label-part", "aria-label", "aria-labelledby", "title-part", "alt", "none"] },
            "required": { "type": "boolean", "description": "true si sin texto visible (IconButton) hay que exigir aria-label." }
          }
        },
        "keyboard": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "action"],
            "additionalProperties": false,
            "properties": { "key": { "type": "string" }, "action": { "type": "string" } }
          }
        },
        "focusVisible": { "type": ["string", "null"], "description": "Parte que muestra el foco (root, control…)." },
        "minTarget": { "type": ["string", "null"], "description": "Token del área mínima, p. ej. size.target.min (24 o 44)." },
        "contrast": { "type": "string", "enum": ["AA", "AAA"] },
        "live": { "type": ["string", "null"], "enum": ["off", "polite", "assertive", null] },
        "reducedMotion": { "type": ["string", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },

    "form": {
      "description": "MÓDULO para controles de formulario: input, textarea, checkbox, switch, radio, select, slider.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "object",
          "required": ["type", "control"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["string", "number", "boolean", "boolean-mixed", "array", "date", "file"] },
            "control": { "type": "string", "enum": ["controlled", "uncontrolled", "both"] }
          }
        },
        "nativeInput": { "type": ["string", "null"], "description": "input[type=checkbox], textarea, select… si lo hay." },
        "label": { "$ref": "#/$defs/partRef" },
        "description": { "$ref": "#/$defs/partRef" },
        "error": { "$ref": "#/$defs/partRef" },
        "required": { "type": "boolean", "description": "¿Soporta required?" },
        "validation": { "type": "array", "items": { "type": "string" }, "description": "required, minLength, maxLength, pattern, min, max…" },
        "submitsAs": { "type": ["string", "null"], "description": "Qué envía en un <form>: el value, 'on'…" }
      }
    },

    "collection": {
      "description": "MÓDULO para padres de un grupo: Tabs, RadioGroup, Accordion, Menu, Select, ToggleGroup.",
      "type": "object",
      "required": ["items", "selection", "navigation"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }, "description": "Contratos hijos." },
        "selection": {
          "type": "object",
          "required": ["cardinality"],
          "additionalProperties": false,
          "properties": {
            "cardinality": { "type": "string", "enum": ["none", "single", "multiple"] },
            "required": { "type": "boolean", "description": "Siempre debe haber uno seleccionado." },
            "initial": { "type": ["string", "null"], "description": "first, none, o un valor." }
          }
        },
        "navigation": {
          "type": "object",
          "required": ["orientation"],
          "additionalProperties": false,
          "properties": {
            "orientation": { "type": "string", "enum": ["horizontal", "vertical", "both"] },
            "wrap": { "type": "boolean" },
            "homeEnd": { "type": "boolean" },
            "typeahead": { "type": "boolean" },
            "followsFocus": { "type": "boolean", "description": "Seleccionar al mover el foco (tabs automáticas)." },
            "rovingFocus": { "type": "boolean" }
          }
        }
      }
    },

    "member": {
      "description": "MÓDULO para hijos de un grupo: TabItem, RadioItem, AccordionItem, MenuItem, Option.",
      "type": "object",
      "required": ["of", "identity", "reflects"],
      "additionalProperties": false,
      "properties": {
        "of": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "identity": { "type": "string", "description": "Prop que lo identifica dentro del grupo, normalmente value." },
        "reflects": { "type": "array", "items": { "type": "string", "enum": ["selected", "checked", "expanded", "highlighted", "disabled", "current"] } }
      }
    },

    "overlay": {
      "description": "MÓDULO para capas: Dialog, Popover, Tooltip, Menu, Select (lista), Toast, Drawer.",
      "type": "object",
      "required": ["opens", "dismisses", "modal", "focus"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "type": ["string", "null"], "description": "Parte o contrato que lo abre." },
        "opens": {
          "type": "object",
          "required": ["on"],
          "additionalProperties": false,
          "properties": {
            "on": { "type": "array", "items": { "type": "string", "enum": ["press", "hover", "focus", "contextmenu", "programmatic", "long-press"] } },
            "delay": { "$ref": "#/$defs/tokenRef" }
          }
        },
        "dismisses": {
          "type": "object",
          "required": ["on"],
          "additionalProperties": false,
          "properties": {
            "on": { "type": "array", "items": { "type": "string", "enum": ["escape", "outside-press", "close-part", "blur", "timeout", "select", "programmatic"] } },
            "timeout": { "$ref": "#/$defs/tokenRef" }
          }
        },
        "modal": { "type": "boolean" },
        "focus": {
          "type": "object",
          "required": ["trap"],
          "additionalProperties": false,
          "properties": {
            "trap": { "type": "boolean" },
            "initial": { "type": ["string", "null"], "description": "Parte que recibe el foco al abrir." },
            "return": { "type": "boolean", "description": "Devolver el foco al trigger al cerrar." }
          }
        },
        "placement": { "type": ["string", "null"], "description": "top, bottom-start, center…" },
        "portal": { "type": "boolean" },
        "scrollLock": { "type": "boolean" }
      }
    },

    "range": {
      "description": "MÓDULO para valores numéricos acotados: Slider, Progress, Meter, Rating.",
      "type": "object",
      "required": ["min", "max", "step"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": ["number", "null"] },
        "pageStep": { "type": ["number", "null"] },
        "orientation": { "type": "string", "enum": ["horizontal", "vertical"] },
        "thumbs": { "type": "integer", "minimum": 1 },
        "valueText": { "type": ["string", "null"], "description": "Cómo se anuncia: '{value} %'…" }
      }
    },

    "media": {
      "description": "MÓDULO para iconos, imágenes, avatares, ilustraciones.",
      "type": "object",
      "required": ["source", "decorative"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["registry", "url", "asset", "slot"], "description": "registry = icons/registry.json." },
        "decorative": { "type": ["boolean", "string"], "description": "true, false o 'prop' (lo decide el consumidor)." },
        "alt": { "type": ["string", "null"], "description": "De dónde sale el texto alternativo." },
        "fallback": { "type": ["string", "null"], "description": "Qué se muestra si falla: initials, icon…" },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "aspectRatio": { "type": ["string", "null"] }
      }
    },

    "data": {
      "description": "MÓDULO para tablas, listas de datos, grids.",
      "type": "object",
      "required": ["columns"],
      "additionalProperties": false,
      "properties": {
        "columns": { "type": ["string", "array"], "description": "'prop' si las define el consumidor o lista fija." },
        "sortable": { "type": "boolean" },
        "selectable": { "type": ["string", "null"], "enum": ["none", "single", "multiple", null] },
        "empty": { "type": ["string", "null"], "description": "Parte o contrato del estado vacío." },
        "loading": { "type": ["string", "null"] },
        "pagination": { "type": ["string", "null"] }
      }
    },

    "content": {
      "description": "Reglas de texto (UX writing).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLength": { "type": ["integer", "null"] },
        "casing": { "type": ["string", "null"], "enum": ["sentence", "title", "upper", "lower", null] },
        "truncation": { "type": ["string", "null"], "enum": ["none", "ellipsis", "wrap", "line-clamp", null] },
        "voice": { "type": ["string", "null"] },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "do": { "type": "array", "items": { "type": "string" } }, "dont": { "type": "array", "items": { "type": "string" } } }
        }
      }
    },

    "composition": {
      "description": "Instancias de otros componentes dentro de este, y lo que nunca puede ir dentro.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nested": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["part", "component"],
            "additionalProperties": false,
            "properties": {
              "part": { "type": "string" },
              "component": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
              "fixedProps": { "type": "object", "description": "Props que el padre fija: {\"size\": \"s\"}." }
            }
          }
        },
        "forbiddenChildren": { "type": "array", "items": { "type": "string" } }
      }
    },

    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "expect"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "given": { "type": "string" }, "expect": { "type": "string" } }
          }
        }
      }
    },

    "meta": {
      "type": "object",
      "required": ["owner", "customization", "needsReview", "provenance", "code"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": ["string", "null"], "description": "Persona o equipo que aprueba cambios en este componente. Obligatorio en stable." },
        "customization": {
          "description": "Qué puede adaptar quien usa el componente sin pedir permiso y qué debe consultar al dueño. Con contenido en stable.",
          "type": "object",
          "required": ["allowed", "askOwner"],
          "additionalProperties": false,
          "properties": {
            "allowed": { "type": "array", "items": { "type": "string" } },
            "askOwner": { "type": "array", "items": { "type": "string" } }
          }
        },
        "deprecation": {
          "description": "Obligatorio en deprecated.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": { "replacedBy": { "type": ["string", "null"] }, "removeIn": { "type": ["string", "null"] }, "adr": { "type": ["string", "null"] } }
        },
        "needsReview": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "description": "Ruta en el contrato: anatomy.root.tokens.border-radius" },
              "reason": { "type": "string" },
              "question": { "type": ["string", "null"], "description": "Pregunta concreta para el dueño." }
            }
          }
        },
        "provenance": {
          "type": "object",
          "description": "Ruta (o bloque) → de dónde salió. inferred bloquea el paso a review.",
          "additionalProperties": {
            "type": "object",
            "required": ["source", "by", "at"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "enum": ["measured", "inferred", "decided"] },
              "by": { "type": "string", "description": "Skill o persona." },
              "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "ref": { "type": ["string", "null"], "description": "ADR, auditoría o nodo de Figma." }
            }
          }
        },
        "code": { "type": ["string", "null"], "description": "Carpeta del código generado. null hasta ds-component." },
        "figmaSyncedAt": { "type": ["string", "null"] }
      }
    }
  },

  "$defs": {
    "tokenRef": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*(\\.([a-z0-9-]|\\{[a-zA-Z0-9]+\\})+)+$",
      "description": "Ruta de token semántico o de componente (color.fill.brand). Admite comodín {prop}. null = sin variable en Figma."
    },
    "partRef": {
      "type": ["string", "null"],
      "description": "Nombre de una parte de anatomy."
    },
    "sizing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["hug", "fill", "fixed"] },
        "token": { "$ref": "#/$defs/tokenRef" },
        "min": { "$ref": "#/$defs/tokenRef" },
        "max": { "$ref": "#/$defs/tokenRef" }
      }
    },
    "part": {
      "type": "object",
      "required": ["figmaLayer", "element"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": ["string", "null"] },
        "figmaLayer": { "type": ["string", "null"], "description": "Nombre de la capa en Figma. null si solo existe en código." },
        "element": { "type": ["string", "null"], "description": "Elemento HTML: div, span, button, label, input, svg…" },
        "parent": { "type": ["string", "null"], "description": "Parte que la contiene. Ausente = root." },
        "role": { "type": ["string", "null"] },
        "optional": { "type": "boolean" },
        "visibleWhen": { "type": ["string", "null"], "description": "Condición: 'icon', 'size!=s', 'state=checked'…" },
        "codeOnly": { "type": "boolean", "description": "Existe solo en código (input nativo oculto, live region…)." },
        "slot": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "accepts": { "type": "array", "items": { "type": "string" }, "description": "Contratos o 'text' / 'any'." },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": ["integer", "null"] },
            "prop": { "type": ["string", "null"], "description": "Prop que lo rellena; null = children." }
          }
        },
        "tokens": { "$ref": "#/$defs/tokenMap" },
        "when": {
          "type": "object",
          "description": "Cambios de token por condición. Claves 'prop=valor' o 'state=nombre', combinables con &.",
          "propertyNames": { "pattern": "^[a-zA-Z0-9]+(!?=)[a-zA-Z0-9-]+(&[a-zA-Z0-9]+(!?=)[a-zA-Z0-9-]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/tokenMap" }
        }
      }
    },
    "tokenMap": {
      "type": "object",
      "description": "Propiedad CSS (kebab-case) → token. 'font' admite un token typography.",
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "$ref": "#/$defs/tokenRef" }
    },
    "pattern": {
      "type": ["string", "null"],
      "description": "Patrón WAI-ARIA APG (https://www.w3.org/WAI/ARIA/apg/patterns/). null = sin patrón interactivo (Card, Badge, Divider).",
      "enum": [
        "accordion", "alert", "alertdialog", "breadcrumb", "button", "toggle-button", "carousel", "checkbox", "combobox",
        "dialog-modal", "disclosure", "feed", "grid", "landmark", "link", "listbox", "menu", "menu-button", "menubar",
        "meter", "progressbar", "radio", "slider", "slider-multithumb", "spinbutton", "switch", "table", "tabs",
        "toolbar", "tooltip", "tree", "treegrid", "window-splitter", "textbox", "status", "img", "separator", null
      ]
    }
  }
}
