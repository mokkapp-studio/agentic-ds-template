    "red": { "500": { "$value": "#E5484D" }, "300": { "$value": "#F2A6A8" } },
    "green": { "500": { "$value": "#30A46C" } },
    "black-a": { "50": { "$value": "#00000080" } }
  },
  "dimension": {
    "$type": "dimension",
    "0": { "$value": "0px" }, "1": { "$value": "1px" }, "2": { "$value": "2px" }, "4": { "$value": "4px" }, "8": { "$value": "8px" }, "12": { "$value": "12px" }, "16": { "$value": "16px" },
