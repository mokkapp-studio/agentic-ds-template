{
  "$schema": "../schemas/vocabulary.schema.json",
  "props": {
    "variant": { "meaning": "Énfasis visual o jerarquía (primary, secondary…).", "example": "<Button variant=\"secondary\">", "replaces": ["kind", "appearance", "emphasis"] },
    "size": { "meaning": "Escala de tamaño.", "example": "<Button size=\"s\">", "values": ["s", "m", "l"], "replaces": ["scale", "dimension", "sz"] },
    "tone": { "meaning": "Intención semántica de color (neutral, brand, danger, success, warning, info).", "example": "<Button tone=\"danger\">", "replaces": ["color", "intent", "status", "severity"] },
    "disabled": { "meaning": "No interactivo y no enfocable (o aria-disabled si debe seguir enfocable).", "example": "<Button disabled>", "replaces": ["isDisabled", "inactive"] },
    "label": { "meaning": "Texto visible principal.", "example": "<Checkbox label=\"Acepto\">", "replaces": ["text", "caption"] },
    "description": { "meaning": "Texto de ayuda bajo la etiqueta.", "example": "<TextField description=\"Mínimo 8 caracteres\">", "replaces": ["helper", "hint", "helperText"] },
    "icon": { "meaning": "Icono del registro.", "example": "<Button icon=\"plus\">", "replaces": ["glyph", "symbol"] }
  },
  "states": {
    "hover": { "meaning": "Puntero encima. CSS :hover.", "example": ".root:hover" },
    "focusVisible": { "meaning": "Foco por teclado. CSS :focus-visible.", "example": ".root:focus-visible", "replaces": ["focus", "focused"] },
    "pressed": { "meaning": "Pulsado en este momento. CSS :active.", "example": ".root:active", "replaces": ["active", "down"] },
    "disabled": { "meaning": "Declarado por el consumidor.", "example": "<Button disabled>" },
    "invalid": { "meaning": "Valor no válido. aria-invalid.", "example": "<TextField invalid> → aria-invalid=\"true\"", "replaces": ["error", "hasError"] },
    "checked": { "meaning": "Marcado (checkbox, switch, radio).", "example": "<Checkbox checked> → aria-checked=\"true\"", "replaces": ["on", "isChecked"] },
    "selected": { "meaning": "Elegido dentro de una colección (tabs, listbox).", "example": "<TabItem selected> → aria-selected=\"true\"", "replaces": ["active", "current"] },
    "expanded": { "meaning": "Abierto (accordion, disclosure).", "example": "aria-expanded=\"true\"", "replaces": ["collapsed", "isExpanded"] },
    "open": { "meaning": "Capa visible (dialog, popover, menu).", "example": "<Dialog open>", "replaces": ["visible", "shown", "isOpen"] }
  },
  "events": {
    "press": { "meaning": "Activación con puntero, teclado o lector.", "example": "onPress()", "replaces": ["click", "tap"] },
    "change": { "meaning": "Cambio de valor confirmado.", "example": "onChange(value)" , "replaces": ["update", "input"] },
    "openChange": { "meaning": "Se abre o se cierra una capa.", "example": "onOpenChange(open)", "replaces": ["toggle", "visibilityChange"] },
    "dismiss": { "meaning": "El usuario descarta (Esc, fuera, cerrar).", "example": "onDismiss()", "replaces": ["close", "cancel"] }
  }
}
